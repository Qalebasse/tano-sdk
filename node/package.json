{
  "name": "@tano-africa/node",
  "version": "0.2.0",
  "description": "Bibliothèque Node.js officielle de l'API Tano : vérification d'identité, signature et cachet électroniques, webhooks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "types": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://docs.tano.africa",
  "keywords": [
    "tano",
    "kyc",
    "identity",
    "verification",
    "e-signature",
    "electronic-seal",
    "africa"
  ],
  "publishConfig": {
    "access": "public"
  }
}
