{
  "name": "@tano-africa/node",
  "version": "0.1.0",
  "description": "Official Node.js library for the Tano identity verification API: cases, journey sessions, results, webhooks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "types": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://docs.tano.africa",
  "keywords": ["tano", "kyc", "identity", "verification", "africa"],
  "publishConfig": {
    "access": "public"
  }
}
